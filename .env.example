
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=DB
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASS
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=DB;Username=USER;Password=PASS

ConnectionStrings__Redis=redis:6379

Kafka__BootstrapServers=kafka:29092
Kafka__OtpRequestsTopic=otp.requests
Kafka__OtpRequestsPartitions=12
Kafka__ConsumerGroupId=otp-ingestion
Kafka__AutoOffsetReset=Earliest

# ─── RabbitMQ
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__Username=otp
RabbitMq__Password=otp
RabbitMq__VirtualHost=/
RabbitMq__DeliveryExchange=otp.delivery
RabbitMq__DeliveryQueue=otp.delivery.queue
RabbitMq__DeadLetterExchange=otp.dlx
RabbitMq__DeadLetterQueue=otp.dlq
RabbitMq__MaxPriority=10
# Retry tier TTLs in ms backoff
RabbitMq__RetryTiersMs=5000;30000;120000;600000;1800000

#WhatsApp Provider 
WhatsApp__Provider=mock
WhatsApp__BaseUrl=http://mockmeta:8080
WhatsApp__PhoneNumberId=000000000000000
WhatsApp__AccessToken=mock-token-not-a-real-secret
WhatsApp__ApiVersion=v20.0
WhatsApp__AppSecret=dev-app-secret-change-me
WhatsApp__VerifyToken=dev-verify-token-change-me

MockMeta__WebhookUrl=http://api:8080/webhooks/whatsapp
MockMeta__SuccessRate=0.95
MockMeta__RateLimit429EveryN=0

# OTP Domain
Otp__CodeLength=6
Otp__TtlSeconds=300
Otp__MaxVerifyAttempts=5
Otp__DedupeWindowSeconds=86400 #------24 Hour
# Pepper for OTP hashing 
Otp__Pepper=dev-pepper-do-not-use-in-prod-32bytes

ASPNETCORE_ENVIRONMENT=Development
Serilog__MinimumLevel__Default=Information
